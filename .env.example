# Local dev: copy to .env.local (gitignored) for real LLM answers in `npm run dev`.
# OPENAI_API_KEY has NO VITE_ prefix, so it's never exposed to the browser bundle —
# the Vite dev server reads it and calls OpenAI server-side.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Production on Vercel: set OPENAI_API_KEY (and optionally OPENAI_MODEL) in the Vercel
# project's Environment Variables — NOT here. The /api/chat function reads them.
#
# Only needed if hosting the chat API on a DIFFERENT origin (e.g. AWS Lambda while the
# site stays on S3): point the build at it. Leave unset for Vercel (same-origin /api/chat).
# VITE_CHAT_API_URL=https://<id>.lambda-url.<region>.on.aws/
